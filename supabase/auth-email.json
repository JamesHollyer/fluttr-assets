{
  "mailer_otp_length": 6,
  "mailer_otp_exp": 600,
  "rate_limit_email_sent": 30,
  "smtp_max_frequency": 30,
  "mailer_subjects_magic_link": "{{ .Token }} is your Fluttr sign-in code",
  "mailer_templates_magic_link_content": "<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;padding:24px;color:#1B241C\"><h2 style=\"color:#2F5F4E;margin:0 0 12px\">Your Fluttr sign-in code</h2><p style=\"margin:0 0 16px\">Type this code into the app:</p><p style=\"font-size:36px;font-weight:700;letter-spacing:8px;margin:0 0 20px;color:#1B241C\">{{ .Token }}</p><p style=\"margin:0 0 8px;color:#5E6A60\">The code expires in 10 minutes. If you are reading this on the same phone, you can also <a href=\"{{ .ConfirmationURL }}\" style=\"color:#2F5F4E\">tap here to sign in</a>.</p><p style=\"margin:16px 0 0;color:#5E6A60;font-size:13px\">If you did not ask for this code, you can ignore this email.</p></div>",
  "mailer_subjects_confirmation": "{{ .Token }} is your Fluttr sign-in code",
  "mailer_templates_confirmation_content": "<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;padding:24px;color:#1B241C\"><h2 style=\"color:#2F5F4E;margin:0 0 12px\">Welcome to Fluttr</h2><p style=\"margin:0 0 16px\">Type this code into the app to finish signing in:</p><p style=\"font-size:36px;font-weight:700;letter-spacing:8px;margin:0 0 20px;color:#1B241C\">{{ .Token }}</p><p style=\"margin:0 0 8px;color:#5E6A60\">The code expires in 10 minutes. On the same phone, you can also <a href=\"{{ .ConfirmationURL }}\" style=\"color:#2F5F4E\">tap here to sign in</a>.</p></div>"
}
