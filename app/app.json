{
  "expo": {
    "name": "Fluttr",
    "slug": "fluttr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fluttr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fluttr.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5F4E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fluttr.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5F4E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fluttr saves where you caught a bird. Your exact location is never shown to other people."
        }
      ],
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Fluttr listens to identify birds by their songs and calls. Audio is analyzed on your phone and is not stored unless you attach it to a catch.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ]
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2F5F4E",
          "defaultChannel": "social"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
